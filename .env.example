# Copy to .env (git-ignored) for local runs; `pnpm start` loads it.

# Discord Developer Portal -> your app -> Bot -> Reset Token.
DISCORD_TOKEN=

# Who may use the bot: comma-separated Discord user IDs (Developer Mode ->
# right-click yourself -> Copy User ID), and server IDs whose members may all
# use it there. With both empty, only the app owner may.
ALLOWED_USERS=
ALLOWED_GUILDS=

# How many recent channel messages the chat model sees (default 30), and an
# optional personality line for it.
# CONTEXT_MESSAGES=30
# BOT_PERSONA=You are a sardonic pirate who knows a lot about homelabs.

# Chat model: any OpenAI-compatible endpoint. Leave CHAT_URL empty to turn /chat off.
CHAT_URL=http://spark.tailc2db57.ts.net:8888/v1
# CHAT_MODEL=            # defaults to the first model the server lists
# CHAT_API_KEY=          # for hosted providers
# pi-ai thinkingFormat; match your model family
CHAT_THINKING_FORMAT=qwen-chat-template
# CHAT_MAX_TOKENS=8192

# Classifier: any System One (Jev-compatible) endpoint. Leave empty to turn /classify off.
CLASSIFIER_URL=http://spark.tailc2db57.ts.net:8001/v1
# sent with each request and shown in replies
CLASSIFIER_MODEL=laya
# CLASSIFIER_API_KEY=    # for hosted providers, e.g. TypeSafe
